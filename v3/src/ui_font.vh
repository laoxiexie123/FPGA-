// 定位：组合 5×7 点阵函数，供包含它的模块调用；不产生时钟或显示时序。
// 可信：无复位、valid/ready；输入字符变化后同拍组合返回字形。
// legacy：ASCII 小写映射大写；未知字符为空白，不扩展字库。
// [width]rule：输入 c 为 8 位，输出 35 位；7 行从高到低，每行 bit4 为左端像素。
// [map]rule：97<=c<=122 时减 32；41 个显式分支，其他编码同拍返回 35'd0。
function [34:0] ui_glyph;
  input [7:0] c;
  reg [7:0] glyph_code_next;
  begin
    glyph_code_next = c;
    if (c >= 8'd97 && c <= 8'd122) begin
      glyph_code_next = c - 8'd32;
    end
    case (glyph_code_next)
      // 字符 "A"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "A": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10001, 5'b11111, 5'b10001, 5'b10001, 5'b10001};
      end
      // 字符 "B"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "B": begin
        ui_glyph = {5'b11110, 5'b10001, 5'b10001, 5'b11110, 5'b10001, 5'b10001, 5'b11110};
      end
      // 字符 "C"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "C": begin
        ui_glyph = {5'b01111, 5'b10000, 5'b10000, 5'b10000, 5'b10000, 5'b10000, 5'b01111};
      end
      // 字符 "D"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "D": begin
        ui_glyph = {5'b11110, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b11110};
      end
      // 字符 "E"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "E": begin
        ui_glyph = {5'b11111, 5'b10000, 5'b10000, 5'b11110, 5'b10000, 5'b10000, 5'b11111};
      end
      // 字符 "F"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "F": begin
        ui_glyph = {5'b11111, 5'b10000, 5'b10000, 5'b11110, 5'b10000, 5'b10000, 5'b10000};
      end
      // 字符 "G"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "G": begin
        ui_glyph = {5'b01111, 5'b10000, 5'b10000, 5'b10111, 5'b10001, 5'b10001, 5'b01111};
      end
      // 字符 "H"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "H": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b10001, 5'b11111, 5'b10001, 5'b10001, 5'b10001};
      end
      // 字符 "I"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "I": begin
        ui_glyph = {5'b11111, 5'b00100, 5'b00100, 5'b00100, 5'b00100, 5'b00100, 5'b11111};
      end
      // 字符 "J"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "J": begin
        ui_glyph = {5'b00111, 5'b00010, 5'b00010, 5'b00010, 5'b10010, 5'b10010, 5'b01100};
      end
      // 字符 "K"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "K": begin
        ui_glyph = {5'b10001, 5'b10010, 5'b10100, 5'b11000, 5'b10100, 5'b10010, 5'b10001};
      end
      // 字符 "L"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "L": begin
        ui_glyph = {5'b10000, 5'b10000, 5'b10000, 5'b10000, 5'b10000, 5'b10000, 5'b11111};
      end
      // 字符 "M"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "M": begin
        ui_glyph = {5'b10001, 5'b11011, 5'b10101, 5'b10101, 5'b10001, 5'b10001, 5'b10001};
      end
      // 字符 "N"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "N": begin
        ui_glyph = {5'b10001, 5'b11001, 5'b10101, 5'b10011, 5'b10001, 5'b10001, 5'b10001};
      end
      // 字符 "O"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "O": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b01110};
      end
      // 字符 "P"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "P": begin
        ui_glyph = {5'b11110, 5'b10001, 5'b10001, 5'b11110, 5'b10000, 5'b10000, 5'b10000};
      end
      // 字符 "Q"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "Q": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10001, 5'b10001, 5'b10101, 5'b10010, 5'b01101};
      end
      // 字符 "R"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "R": begin
        ui_glyph = {5'b11110, 5'b10001, 5'b10001, 5'b11110, 5'b10100, 5'b10010, 5'b10001};
      end
      // 字符 "S"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "S": begin
        ui_glyph = {5'b01111, 5'b10000, 5'b10000, 5'b01110, 5'b00001, 5'b00001, 5'b11110};
      end
      // 字符 "T"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "T": begin
        ui_glyph = {5'b11111, 5'b00100, 5'b00100, 5'b00100, 5'b00100, 5'b00100, 5'b00100};
      end
      // 字符 "U"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "U": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b01110};
      end
      // 字符 "V"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "V": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b10001, 5'b01010, 5'b00100};
      end
      // 字符 "W"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "W": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b10001, 5'b10101, 5'b10101, 5'b10101, 5'b01010};
      end
      // 字符 "X"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "X": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b01010, 5'b00100, 5'b01010, 5'b10001, 5'b10001};
      end
      // 字符 "Y"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "Y": begin
        ui_glyph = {5'b10001, 5'b10001, 5'b01010, 5'b00100, 5'b00100, 5'b00100, 5'b00100};
      end
      // 字符 "Z"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "Z": begin
        ui_glyph = {5'b11111, 5'b00001, 5'b00010, 5'b00100, 5'b01000, 5'b10000, 5'b11111};
      end
      // 字符 "0"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "0": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10011, 5'b10101, 5'b11001, 5'b10001, 5'b01110};
      end
      // 字符 "1"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "1": begin
        ui_glyph = {5'b00100, 5'b01100, 5'b00100, 5'b00100, 5'b00100, 5'b00100, 5'b01110};
      end
      // 字符 "2"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "2": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b00001, 5'b00010, 5'b00100, 5'b01000, 5'b11111};
      end
      // 字符 "3"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "3": begin
        ui_glyph = {5'b11110, 5'b00001, 5'b00001, 5'b01110, 5'b00001, 5'b00001, 5'b11110};
      end
      // 字符 "4"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "4": begin
        ui_glyph = {5'b00010, 5'b00110, 5'b01010, 5'b10010, 5'b11111, 5'b00010, 5'b00010};
      end
      // 字符 "5"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "5": begin
        ui_glyph = {5'b11111, 5'b10000, 5'b10000, 5'b11110, 5'b00001, 5'b00001, 5'b11110};
      end
      // 字符 "6"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "6": begin
        ui_glyph = {5'b01110, 5'b10000, 5'b10000, 5'b11110, 5'b10001, 5'b10001, 5'b01110};
      end
      // 字符 "7"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "7": begin
        ui_glyph = {5'b11111, 5'b00001, 5'b00010, 5'b00100, 5'b01000, 5'b01000, 5'b01000};
      end
      // 字符 "8"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "8": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10001, 5'b01110, 5'b10001, 5'b10001, 5'b01110};
      end
      // 字符 "9"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "9": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b10001, 5'b01111, 5'b00001, 5'b00001, 5'b01110};
      end
      // 字符 "-"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "-": begin
        ui_glyph = {5'b00000, 5'b00000, 5'b00000, 5'b11111, 5'b00000, 5'b00000, 5'b00000};
      end
      // 字符 "+"：同拍返回对应 5×7 点阵，行从上至下、位从左至右。
      "+": begin
        ui_glyph = {5'b00000, 5'b00100, 5'b00100, 5'b11111, 5'b00100, 5'b00100, 5'b00000};
      end
      // 冒号字符：同拍返回上下双点的 5×7 点阵，行从上至下、位从左至右。
      ":": begin
        ui_glyph = {5'b00000, 5'b00100, 5'b00100, 5'b00000, 5'b00100, 5'b00100, 5'b00000};
      end
      // 问号字符：同拍返回弯钩与底点的 5×7 点阵，行从上至下、位从左至右。
      "?": begin
        ui_glyph = {5'b01110, 5'b10001, 5'b00001, 5'b00010, 5'b00100, 5'b00000, 5'b00100};
      end
      // 小数点字符：同拍返回底部双行单点的 5×7 点阵，行从上至下、位从左至右。
      ".": begin
        ui_glyph = {5'b00000, 5'b00000, 5'b00000, 5'b00000, 5'b00000, 5'b00100, 5'b00100};
      end
      // 未列字符同拍返回空白 35 位点阵。
      default: begin
        ui_glyph = 35'd0;
      end
    endcase
  end
endfunction
